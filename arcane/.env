# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17"
ARCANE_IMAGE_TAG="latest"

#-[ Timezone
TZ="America/Chicago"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Postgres
POSTGRES_USER=${S_ARCANE_POSTGRES_USER}
POSTGRES_PASSWORD=${S_ARCANE_POSTGRES_PASSWORD}
POSTGRES_DB="arcane"

#-[ Arcane
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"

# ––––––––––––––––––––––––––––––––––––––
# –––––––––-–––  ARCANE  –––––––––––-–-–
# ––––––––––––––––––––––––––––––––––––––

#-[ General
# Primary URL
SUBDOMAIN="arcane"
DOMAIN="jjcasa.net"
APP_URL="https://${SUBDOMAIN}.${DOMAIN}"
# Runas
PUID="1000"
PGID="1000"

#-[ Secrets & Keys
ENCRYPTION_KEY=${S_ARCANE_ENCRYPTION_KEY}
JWT_SECRET=${S_ARCANE_JWT_SECRET}

#-[ OIDC
OIDC_ENABLED=true
OIDC_CLIENT_ID=${S_ARCANE_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${S_ARCANE_OIDC_CLIENT_SECRET}
OIDC_ISSUER_URL=${S_ARCANE_OIDC_ISSUER_URL}
OIDC_SCOPES="openid email profile"

#-[ Logging
LOG_LEVEL="info"
LOG_JSON="false"
