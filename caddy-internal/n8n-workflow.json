    {
      "parameters": {
        "jsCode": "// Define the static Gatekeeper block\nconst gatekeeperConfig = `\n{\n    admin localhost:2019\n}\n\n:2020 {\n    @authorized {\n        header X-Caddy-Token \"fbaf07f9fd9578c757a9a7007b5c3eda8f1e53a5a505ae55b9b70a4701b9b705\"\n    }\n    handle @authorized {\n        reverse_proxy localhost:2019 {\n            header_up Host localhost:2019\n        }\n    }\n    respond \"Unauthorized\" 403\n}\n`;\n\n// Start building the file\nlet caddyfile = gatekeeperConfig + \"\\n\";\n\n// Loop through your DB results and append sites\nfor (const item of $input.all()) {\n   const site = item.json;\n\n// -- LOGIC: Handle HTTPS Backends --\n  let skipVerification = \"\";\n\n  if (site.targetScheme === 'https') {\n      // Since internal HTTPS services (like Proxmox) usually have self-signed certs,\n      // we must explicitly tell Caddy to trust them.\n      skipVerification = `\n      transport http {\n          tls\n          tls_insecure_skip_verify\n      }`;\n  }\n\n  caddyfile += `\n  ${site.name} {\n    reverse_proxy ${site.target}:${site.targetPort} {\n      ${skipVerification}\n    }\n    tls { \n      dns cloudflare {env.CLOUDFLARE_API_TOKEN}\n    }\n  }\\n`;\n}\n\nreturn [{ json: { config: caddyfile } }];"
      },
      "type": "n8n-nodes-base.code",
