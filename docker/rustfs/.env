# Secrets Manager Variables:
# CLOUDFLARE_API_TOKEN
# SSL_EMAIL
# RUSTFS_ACCESS_KEY "$(openssl rand -hex 32)"
# RUSTFS_SECRET_KEY "$(openssl rand -hex 32)"
# RUSTFS_OIDC_ISSUER
# RUSTFS_OIDC_CLIENT_ID
# RUSTFS_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
RUSTFS_IMAGE_TAG="latest"


# --------------------------------------
# -------------  CADDY  ----------------
# --------------------------------------

#-[ ACME
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}

#-[ Let's Encrypt Notifications
SSL_EMAIL=${SSL_EMAIL}


# --------------------------------------
# -------------  RUSTFS  ---------------
# --------------------------------------

#-[ Network
BASE_URL="*.rustfs.jjcasa.net"
RUSTFS_ADDRESS=":9000"
RUSTFS_CONSOLE_ADDRESS=":9001"
RUSTFS_CONSOLE_ENABLE="true"

#-[ Secrets
RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY}
RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY}

#-[ Virtual Host Configuration
RUSTFS_SERVER_DOMAINS="rustfs.jjcasa.net"

#-[ Logging
RUSTFS_OBS_LOGGER_LEVEL="error"
RUSTFS_OBS_LOG_DIRECTORY="/opt/rustfs_data/logs/"

#-[ Authentication
RUSTFS_BROWSER_REDIRECT_URL="https://rustfs.jjcasa.net"
RUSTFS_IDENTITY_OPENID_ENABLE="on"
RUSTFS_IDENTITY_OPENID_CONFIG_URL=${RUSTFS_OIDC_ISSUER}
RUSTFS_IDENTITY_OPENID_CLIENT_ID=${RUSTFS_OIDC_CLIENT_ID}
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=${RUSTFS_OIDC_CLIENT_SECRET}
RUSTFS_IDENTITY_OPENID_SCOPES="openid,profile,email,groups"
RUSTFS_IDENTITY_OPENID_REDIRECT_URI="https://rustfs.jjcasa.net/rustfs/admin/v3/oidc/callback/default"
RUSTFS_IDENTITY_OPENID_REDIRECT_URI_DYNAMIC="off"
RUSTFS_IDENTITY_OPENID_DISPLAY_NAME="JJCasa ID"
RUSTFS_IDENTITY_OPENID_GROUPS_CLAIM="groups"
RUSTFS_IDENTITY_OPENID_ROLES_CLAIM="roles"
RUSTFS_IDENTITY_OPENID_EMAIL_CLAIM="email"
RUSTFS_IDENTITY_OPENID_USERNAME_CLAIM="preferred_username"
