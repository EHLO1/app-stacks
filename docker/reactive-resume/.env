# Secrets Manager Variables:
# REACTIVE_RESUME_POSTGRES_USER
# REACTIVE_RESUME_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# REACTIVE_RESUME_AUTH_SECRET "$(openssl rand -hex 32)"
# REACTIVE_RESUME_ENCRYPTION_SECRET "$(openssl rand -hex 32)"
# REACTIVE_RESUME_S3_ACCESS_KEY
# REACTIVE_RESUME_S3_SECRET_KEY
# REACTIVE_RESUME_OIDC_ISSUER
# REACTIVE_RESUME_OIDC_CLIENT_ID
# REACTIVE_RESUME_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"
REACTIVE_RESUME_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="reactive-resume"
POSTGRES_USER=${REACTIVE_RESUME_POSTGRES_USER}
POSTGRES_PASSWORD=${REACTIVE_RESUME_POSTGRES_PASSWORD}

#-[ Valkey
REDIS_URL="redis://reactive-resume-valkey:6379"


# --------------------------------------
# ---------  REACTIVE RESUME  ----------
# --------------------------------------

#-[ Network
APP_URL="https://resume.jjcasa.net"

#-[ General
TZ="America/Chicago"

#-[ Database Connection
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTRGRES_PASSWORD}@reactive-resume-postgres:5432/${POSTGRES_DB}"

#-[ Secrets
AUTH_SECRET=${REACTIVE_RESUME_AUTH_SECRET}
ENCRYPTION_SECRET=${REACTIVE_RESUME_ENCRYPTION_SECRET}

#-[ Storage
S3_ACCESS_KEY_ID=${REACTIVE_RESUME_S3_ACCESS_KEY}
S3_SECRET_ACCESS_KEY=${REACTIVE_RESUME_S3_SECRET_KEY}
S3_REGION="us-east-1"
S3_ENDPOINT="https://s3.jjcasa.net"
S3_BUCKET="reactive-resume"
S3_FORCE_PATH_STYLE="false"

#-[ Authentication
FLAG_DISABLE_EMAIL_AUTH="true"
OAUTH_PROVIDER_NAME="JJCasa ID"
OAUTH_CLIENT_ID=${REACTIVE_RESUME_OIDC_CLIENT_ID}
OAUTH_CLIENT_SECRET=${REACTIVE_RESUME_OIDC_CLIENT_SECRET}
OAUTH_DISCOVERY_URL="${REACTIVE_RESUME_OIDC_ISSUER}/.well-known/openid-configuration"
