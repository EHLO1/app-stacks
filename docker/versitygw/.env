# Secrets Manager Variables:
# CLOUDFLARE_API_TOKEN
# SSL_EMAIL
# VERSITYGW_ROOT_ACCESS_KEY "$(openssl rand -hex 32)"
# VERSITYGW_ROOT_SECRET_KEY "$(openssl rand -hex 32)"

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
VERSITYGW_IMAGE_TAG="latest"


# --------------------------------------
# -------------  CADDY  ----------------
# --------------------------------------

#-[ ACME
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}

#-[ Let's Encrypt Notifications
SSL_EMAIL=${SSL_EMAIL}


# --------------------------------------
# ------------  VERSITYGW  -------------
# --------------------------------------

#-[ General
BASE_URL="vgw-s3.jjcasa.net"

#-[ S3 Gateway Specific Config (versitygw)
VGW_WEBUI_S3_PORT=":7070"
VGW_WEBUI_S3_BACKEND="posix"
VGW_WEBUI_S3_BACKEND_ARGS="/data/s3"
VGW_WEBUI_S3_VERSIONING_DIR="/data/versioning"
VGW_WEBUI_S3_PREFIX="/ui"
VGW_WEBUI_GATEWAYS="https://${BASE_URL}"
VGW_WEBUI_IAM_GATEWAYS="https://${BASE_URL}/iam"
VGW_IAM_STANDALONE_ENDPOINT="/run/vgw/iam.sock"
VGW_IAM_STANDALONE_DEFAULT_UID="0"
VGW_IAM_STANDALONE_DEFAULT_GID="0"

#-[ Shared Config
VGW_VIRTUAL_DOMAIN=${BASE_URL}
VGW_CORS_ALLOW_ORIGIN="https://${BASE_URL}"
VGW_REGION="us-east-1"
ROOT_ACCESS_KEY=${VERSITYGW_ROOT_ACCESS_KEY}
ROOT_SECRET_KEY=${VERSITYGW_ROOT_SECRET_KEY}

#-[ IAM Specific Config (versitygw-iam)
VGW_IAM_PORT=":7076"
VGW_IAM_DIR="/data/iam"
VGW_IAM_BACKEND="iam"
VGW_IAM_PRIVATE_PORTS=${VGW_IAM_STANDALONE_ENDPOINT}
VGW_IAM_PRIVATE_SOCKET_PERM="0660"
