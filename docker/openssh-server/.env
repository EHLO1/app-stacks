# Secrets Manager Variables:
# OPENSSH_SERVER_PUBLIC_KEY
# OPENSSH_SERVER_USER_PASSWORD "$(openssl rand -hex 32)"
# OPENSSH_SERVER_USER_NAME

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
OPENSSH_SERVER_IMAGE_TAG="latest"

#-[ Timezone
TZ="America/Chicago"


# ––––––––––––––––––––––––––––––––––––––
# –––-–––––  OPENSSH-SERVER  –––––––––-–
# ––––––––––––––––––––––––––––––––––––––

#-[ RunAs
# One day I'll be cool enough to figure out permissions on Docker Volumes...
# But it is not this day.
PUID="0"
PGID="0"

#-[ Permissions
SUDO_ACCESS="false"
PASSWORD_ACCESS="false"

#-[ Authentication
PUBLIC_KEY=${OPENSSH_SERVER_PUBLIC_KEY}
USER_PASSWORD=${OPENSSH_SERVER_USER_PASSWORD}
USER_NAME=${OPENSSH_SERVER_USER_NAME}
