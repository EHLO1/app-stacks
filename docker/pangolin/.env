# Secrets Manager Variables:
# POSTGRES_USER
# POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# GEOIPUPDATE_ACCOUNT_ID
# GEOIPUPDATE_LICENSE_KEY
# CLOUDFLARE_API_TOKEN

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
PANGOLIN_IMAGE_TAG="ee-postgresql-latest"
GERBIL_IMAGE_TAG="latest"
TRAEFIK_IMAGE_TAG="v3.7"
GEOIPUPDATE_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="pangolin"
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}


# --------------------------------------
# ------------  PANGOLIN  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_CONNECTION_STRING="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}""


# --------------------------------------
# ------------  TRAEFIK  ---------------
# --------------------------------------

#-[ ACME Challenge
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}


# --------------------------------------
# -------  MAXMIND GEOIPUPDATE  --------
# --------------------------------------

#-[ GeoIP Data Fetcher
GEOIPUPDATE_ACCOUNT_ID=${GEOIPUPDATE_ACCOUNT_ID}
GEOIPUPDATE_LICENSE_KEY=${GEOIPUPDATE_LICENSE_KEY}
# Databases to Download
GEOIPUPDATE_EDITION_IDS="GeoLite2-Country GeoLite2-ASN"
# Frequency of Downloads in Hours
GEOIPUPDATE_FREQUENCY="72"
