# Secrets Manager Variables:
# OBSYNC_COUCHDB_PASSWORD "$(openssl rand -hex 32)"

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
COUCHDB_IMAGE_TAG="latest"


# --------------------------------------
# -----  COUCHDB (OBSIDIAN-SYNC)  ------
# --------------------------------------

#-[ Secrets
COUCHDB_USER="obsidiansync"
COUCHDB_PASSWORD=${OBSYNC_COUCHDB_PASSWORD}
