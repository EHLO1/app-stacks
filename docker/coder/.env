# Secrets Manager Variables:
# CODER_POSTGRES_USER
# CODER_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# CODER_OIDC_ISSUER
# CODER_OIDC_CLIENT_ID
# CODER_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
CODER_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="coder"
POSTGRES_USER=${CODER_POSTGRES_USER}
POSTGRES_PASSWORD=${CODER_POSTGRES_PASSWORD}


# --------------------------------------
# -------------  CODER  ----------------
# --------------------------------------

#-[ Network
CODER_HTTP_ADDRESS="0.0.0.0:7080"
CODER_ACCESS_URL="https://coder.jjcasa.net"
CODER_WILDCARD_ACCESS_URL="*-coder.jjcasa.net"
CODER_DISABLE_PATH_APPS="true"

#-[ Database
CODER_PG_CONNECTION_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@coder-postgres:5432/${POSTGRES_DB}?sslmode=disable"

#-[ Authentication
CODER_OIDC_GROUP_AUTO_CREATE="true"
CODER_OIDC_ALLOW_SIGNUPS="true"
CODER_OIDC_ALLOWED_GROUPS="coder_admins,coder_users"
CODER_OIDC_ISSUER_URL=${CODER_OIDC_ISSUER}
CODER_OIDC_CLIENT_ID=${CODER_OIDC_CLIENT_ID}
CODER_OIDC_CLIENT_SECRET=${CODER_OIDC_CLIENT_SECRET}
CODER_OIDC_GROUP_FIELD="groups"
CODER_OIDC_SCOPES="openid,profile,email,groups,offline_access"
CODER_OIDC_USERNAME_FIELD="email"
CODER_OIDC_ICON_URL="https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/pocket-id.svg"
CODER_OIDC_SIGN_IN_TEXT="Sign in with JJCasa ID"
CODER_DISABLE_PASSWORD_AUTH="true"
