# Secrets Manager Variables:
#   OUTLINE_POSTGRES_USER
#   OUTLINE_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
#   OUTLINE_SECRET_KEY "$(openssl rand -hex 32)"
#   OUTLINE_UTILS_SECRET "$(openssl rand -hex 32)"
#   OUTLINE_OIDC_ISSUER_URL
#   OUTLINE_OIDC_CLIENT_ID
#   OUTLINE_OIDC_CLIENT_SECRET

# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"
OUTLINE_IMAGE_TAG="latest"


# ––––––––––––––––––––––––––––––––––––––
# ––––––––––––  DATABASES  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Postgres
POSTGRES_DB="outline"
POSTGRES_USER=${OUTLINE_POSTGRES_USER}
POSTGRES_PASSWORD=${OUTLINE_POSTGRES_PASSWORD}

#-[ Valkey
REDIS_URL="redis://outline-valkey:6379"
REDIS_MAX_MEMORY="2147483648"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––-–––  OUTLINE  -–––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Network
URL="https://docs.jjcasa.net"
PORT="3000"
FORCE_HTTPS="false"
WEB_CONCURRENCY="4"
RATE_LIMITER_ENABLED="true"
RATE_LIMITER_REQUESTS="1000"
RATE_LIMITER_DURATION_WINDOW="60"

#-[ Secrets
SECRET_KEY=${OUTLINE_SECRET_KEY}
UTILS_SECRET=${OUTLINE_UTILS_SECRET}

#-[ Database Connection
DATABASE_HOST="outline-postgres"
DATABASE_PORT="5432"
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_CONNECTION_POOL_MIN="5"
DATABASE_CONNECTION_POOL_MAX="25"
PGSSLMODE="disable"

#-[ File Storage
FILE_STORAGE="local"
FILE_STORAGE_LOCAL_ROOT_DIR="/var/lib/outline/data"
FILE_STORAGE_UPLOAD_MAX_SIZE="262144000"

#-[ Authentication
OIDC_ISSUER_URL=${OUTLINE_OIDC_ISSUER_URL}
OIDC_CLIENT_ID=${OUTLINE_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${OUTLINE_OIDC_CLIENT_SECRET}
OIDC_USERNAME_CLAIM="email"
OIDC_DISPLAY_NAME="JJCasa ID"
OIDC_SCOPES="openid profile email groups"

#-[ Miscellaneous
NODE_ENV="production"
DEFAULT_LANGUAGE="en_US"
ENABLE_UPDATES="true"
LOG_LEVEL="info"
