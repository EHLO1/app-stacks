# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17"
REDIS_IMAGE_TAG="7-alpine"
N8N_IMAGE_TAG="latest"
N8N_RUNNERS_IMAGE_TAG="latest"

#-[ Timezone
GENERIC_TIMEZONE="America/Chicago"

#-[ Access
APP_DOMAIN_NAME="n8n.example.com"
APP_PORT="12345"

#-[ Logging
LOG_LEVEL="info"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Postgres
POSTGRES_DB="n8n"
POSTGRES_USER=${S_N8N_POSTGRES_USER}
POSTGRES_PASSWORD=${S_N8N_POSTGRES_PASSWORD}


# ––––––––––––––––––––––––––––––––––––––
# ––––––––––  REDIS MONITOR  –––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ General
REDIS_HOST="redis"
REDIS_PORT="6379"
QUEUE_NAME_PREFIX="bull"
QUEUE_NAME="jobs"
POLL_INTERVAL_SECONDS="5"


# ––––––––––––––––––––––––––––––––––––––
# ––––––––––  N8N AUTOSCALER  ––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ General
COMPOSE_PROJECT_NAME="n8n"
COMPOSE_FILE_PATH="/app/compose.yaml"
N8N_WORKER_SERVICE_NAME="n8n-worker"
N8N_WORKER_RUNNER_SERVICE_NAME="n8n-worker-runner"

#-[ Scaling
MIN_REPLICAS="1"
MAX_REPLICAS="5"
SCALE_UP_QUEUE_THRESHOLD="5"
SCALE_DOWN_QUEUE_THRESHOLD="1"
POLLING_INTERVAL_SECONDS="10"
COOLDOWN_PERIOD_SECONDS="10"

#-[ Shutdown Timeouts
N8N_QUEUE_BULL_GRACEFULSHUTDOWNTIMEOUT="300"
N8N_GRACEFUL_SHUTDOWN_TIMEOUT="300"


# ––––––––––––––––––––––––––––––––––––––
# ––––––-––  N8N TASK RUNNERS  –––––-–––
# ––––––––––––––––––––––––––––––––––––––

#-[ General
N8N_RUNNERS_TASK_BROKER_URI="http://n8n:5679"
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT="15"
N8N_RUNNERS_MAX_CONCURRENCY="5"

#-[ Logging
N8N_RUNNERS_LAUNCHER_LOG_LEVEL="info"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––––  N8N WORKERS  –––––––-–-––
# ––––––––––––––––––––––––––––––––––––––

#-[ Secrets
N8N_ENCRYPTION_KEY=${S_N8N_ENCRYPTION_KEY}

#-[ Executions
EXECUTIONS_MODE="queue"
# Set to "true" to run manual executions on the worker node.
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS="true"

#-[ Redis
QUEUE_BULL_REDIS_HOST="redis"
QUEUE_BULL_REDIS_PORT="6379"

#-[ Health Check
QUEUE_HEALTH_CHECK_ACTIVE="true"


# ––––––––––––––––––––––––––––––––––––––
# –––––––--–––––  N8N  –––––-–––-–--––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Networking
# Primary URL
N8N_PROTOCOL="https"
N8N_HOST=${APP_DOMAIN_NAME}
N8N_PORT="5678"
# Required when n8n is running behind a reverse proxy
N8N_PROXY_HOPS=1
WEBHOOK_URL="${N8N_PROTOCOL}://${APP_DOMAIN_NAME}:${APP_PORT}/"
# N8N Platform API
N8N_PUBLIC_API_SWAGGERUI_DISABLED="false"

#-[ Database Settings
DB_TYPE="postgresdb"
DB_POSTGRESDB_HOST="postgres"
DB_POSTGRESDB_PORT="5432"
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${S_N8N_POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${S_N8N_POSTGRES_PASSWORD}

#-[ Runners
N8N_RUNNERS_MODE="external"
N8N_RUNNERS_AUTH_TOKEN=${S_N8N_RUNNERS_AUTH_TOKEN}
N8N_RUNNERS_BROKER_LISTEN_ADDRESS="0.0.0.0"
N8N_RUNNERS_INSECURE_MODE="false"
N8N_PYTHON_ENABLED="true"
N8N_NATIVE_PYTHON_RUNNER="true"

#-[ Metrics & Diagnostics
N8N_DIAGNOSTICS_ENABLED="true"
N8N_METRICS="true"

#-[ Secrets
N8N_USER_MANAGEMENT_JWT_SECRET=${S_N8N_USER_MANAGEMENT_JWT_SECRET}

#-[ Data Limits
N8N_DATA_TABLES_MAX_SIZE_BYTES="1048576000"  # 1GB in bytes, adjust as needed
N8N_BLOCK_ENV_ACCESS_IN_NODE="false"

#-[ Miscellaneous
N8N_USER_FOLDER="/n8n/main"
N8N_DEFAULT_BINARY_DATA_MODE="database"
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="false"
N8N_VERSION_NOTIFICATIONS_ENABLED="true"
# Community Packages
N8N_COMMUNITY_PACKAGES_ENABLED="true"
# Disable n8n bloat
N8N_PERSONALIZATION_ENABLED="false"
N8N_HIRING_BANNER_ENABLED="false"
