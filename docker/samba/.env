# Secrets Manager Variables:
# SAMBA_USER
# SAMBA_PASS

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
SAMBA_IMAGE_TAG="latest"


# --------------------------------------
# -------------  SAMBA  ----------------
# --------------------------------------

#-[ Share Name
NAME="backups"

#-[ Authentication
USER=${SAMBA_USER}
PASS=${SAMBA_PASS}
