# Secrets Manager Variables:
# GRIST_POSTGRES_USER
# GRIST_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# GRIST_SESSION_SECRET "$(openssl rand -hex 32)"
# GRIST_DEFAULT_EMAIL
# GRIST_OIDC_ISSUER
# GRIST_OIDC_CLIENT_ID
# GRIST_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"
GRIST_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="grist"
POSTGRES_USER=${GRIST_POSTGRES_USER}
POSTGRES_PASSWORD=${GRIST_POSTGRES_PASSWORD}

#-[ Valkey
REDIS_URL="redis://grist-valkey:6379/0"


# --------------------------------------
# -------------  GRIST  ----------------
# --------------------------------------

#-[ Network
APP_HOME_URL="https://grist.jjcasa.net"
PORT="8484"

#-[ Secrets
GRIST_SESSION_SECRET=${GRIST_SESSION_SECRET}

#-[ General
GRIST_WIDGET_LIST_URL="https://github.com/gristlabs/grist-widget/releases/download/latest/manifest.json"
GRIST_ANON_PLAYGROUND="false"
GRIST_SINGLE_ORG="docs"
GRIST_SANDBOX_FLAVOR="gvisor"

#-[ Database Connection
TYPEORM_TYPE="postgres"
TYPEORM_HOST="grist-postgres"
TYPEORM_PORT="5432"
TYPEORM_DATABASE=${POSTGRES_DB}
TYPEORM_USERNAME=${POSTGRES_USER}
TYPEORM_PASSWORD=${POSTGRES_PASSWORD}

#-[ Authentication
# Redirect is https://auth.example.com/oauth2/callback
GRIST_DEFAULT_EMAIL=${GRIST_DEFAULT_EMAIL}
GRIST_FORCE_LOGIN="true"
GRIST_OIDC_IDP_ISSUER=${GRIST_OIDC_ISSUER}
GRIST_OIDC_IDP_CLIENT_ID=${GRIST_OIDC_CLIENT_ID}
GRIST_OIDC_IDP_CLIENT_SECRET=${GRIST_OIDC_CLIENT_SECRET}
GRIST_OIDC_SP_IGNORE_EMAIL_VERIFIED="true"
