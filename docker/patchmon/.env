# Secrets Manager Variables:
#   PATCHMON_POSTGRES_USER
#   PATCHMON_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
#   PATCHMON_JWT_SECRET "$(openssl rand -hex 64)"
#   PATCHMON_AI_ENCRYPTION_KEY "$(openssl rand -hex 64)"
#   PATCHMON_SESSION_SECRET "$(openssl rand -hex 64)"
#   PATCHMON_OIDC_ISSUER_URL
#   PATCHMON_OIDC_CLIENT_ID
#   PATCHMON_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"
GUACD_IMAGE_TAG="1.5.5"
PATCHMON_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="patchmon"
POSTGRES_USER=${PATCHMON_POSTGRES_USER}
POSTGRES_PASSWORD=${PATCHMON_POSTGRES_PASSWORD}

#-[ Valkey
REDIS_HOST="patchmon-valkey"
REDIS_PORT="6379"
# REDIS_DB="0"


# --------------------------------------
# ------------  PATCHMON  ---------------
# --------------------------------------

#-[ Network
FRONTEND_URL="https://patchmon.jjcasa.net"
PORT="3000"
TRUST_PROXY="true"
CORS_ORIGIN="http://localhost:${PORT},http://patchmon:${PORT},${FRONTEND_URL}"
GUACD_ADDRESS="patchmon-guacd:4822"

#-[ Secrets
JWT_SECRET=${PATCHMON_JWT_SECRET}
AI_ENCRYPTION_KEY=${PATCHMON_AI_ENCRYPTION_KEY}
SESSION_SECRET=${PATCHMON_SESSION_SECRET}

#-[ Database Connection
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@patchmon-postgres:5432/${POSTGRES_DB}"
PM_DB_CONN_MAX_ATTEMPTS="30"
PM_DB_CONN_WAIT_INTERVAL="2"
DB_CONNECTION_LIMIT="30"
DB_CONNECT_TIMEOUT="10"
DB_TRANSACTION_LONG_TIMEOUT="60000"

#-[ Authentication
OIDC_ENABLED="true"
OIDC_ISSUER_URL=${PATCHMON_OIDC_ISSUER_URL}
OIDC_CLIENT_ID=${PATCHMON_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${PATCHMON_OIDC_CLIENT_SECRET}
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid email profile groups"
OIDC_AUTO_CREATE_USERS="true"
OIDC_DEFAULT_ROLE="user"
OIDC_DISABLE_LOCAL_AUTH="true"
OIDC_BUTTON_TEXT="Login with JJCasa ID"
OIDC_SESSION_TTL="600"
OIDC_POST_LOGOUT_URI="https://patchmon.jjcasa.net"
OIDC_SYNC_ROLES="true"
OIDC_ADMIN_GROUP="patchmon_admins"
OIDC_SUPERADMIN_GROUP="patchmon_admins"
OIDC_READONLY_GROUP="patchmon_viewers"
OIDC_ENFORCE_HTTPS="true"

#-[ Session
AUTH_BROWSER_SESSION_COOKIES="true"
JWT_EXPIRES_IN="4h"

#-[ Miscellaneous
TZ="America/Chicago"
APP_ENV="production"

#-[ Logging
ENABLE_LOGGING="true"
LOG_LEVEL="info"
