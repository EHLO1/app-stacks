# Secrets Manager Variables:
# TERMIX_JWT_SECRET "$(openssl rand -hex 32)"
# TERMIX_DATABASE_KEY "$(openssl rand -hex 32)"
# TERMIX_INTERNAL_AUTH_TOKEN "$(openssl rand -hex 32)"
# TERMIX_OIDC_ISSUER_URL
# TERMIX_OIDC_CLIENT_ID
# TERMIX_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
TERMIX_IMAGE_TAG="latest"
GUACD_IMAGE_TAG="1.6.0"


# --------------------------------------
# -------------  TERMIX  ---------------
# --------------------------------------
# Reference: https://docs.termix.site/setup/environment-variables

#-[ Networking
PORT="8080"
GUACD_HOST="termix-guacd"
GUACD_PORT="4822"

#-[ General
NODE_ENV="production"
PUID="1000"
GUID="1000"

#-[ Secrets
JWT_SECRET=${TERMIX_JWT_SECRET}
DATABASE_KEY=${TERMIX_DATABASE_KEY}
INTERNAL_AUTH_TOKEN=${TERMIX_INTERNAL_AUTH_TOKEN}

#-[ Logging
LOG_LEVEL="info"

#-[ Authentication
OIDC_ISSUER_URL=${TERMIX_OIDC_ISSUER_URL}
OIDC_CLIENT_ID=${TERMIX_OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${TERMIX_OIDC_CLIENT_SECRET}
OIDC_SCOPES="openid email profile groups"
OIDC_ADMIN_GROUP="termix_admins"
OIDC_GROUP_CLAIM="groups"
OIDC_FORCE_HTTPS="true"
OIDC_ALLOW_REGISTRATION="true"
ALLOW_REGISTRATION="true"
ALLOW_PASSWORD_LOGIN="true"
ALLOW_PASSWORD_RESET="true"
