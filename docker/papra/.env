# Secrets Manager Variables:
# PAPRA_RESTIC_REPOSITORY_PASSWORD "$(openssl rand -hex 32)"
# PAPRA_RESTIC_S3_ACCESS_KEY
# PAPRA_RESTIC_S3_SECRET_KEY
# PAPRA_OPENROUTER_API_KEY
# PAPRA_AUTH_SECRET "$(openssl rand -hex 48)"
# PAPRA_OIDC_CLIENT_ID
# PAPRA_OIDC_CLIENT_SECRET
# PAPRA_OIDC_ISSUER

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
PAPRA_IMAGE_TAG="latest"
RESTIC_IMAGE_TAG="latest"


# --------------------------------------
# -------------  RESTIC  ---------------
# --------------------------------------

#-[ General
RESTIC_S3_BUCKET="papra-volume-backup"
RESTIC_REPOSITORY="s3:https://s3.jjcasa.net/${RESTIC_S3_BUCKET}"
RESTIC_PASSWORD=${PAPRA_RESTIC_REPOSITORY_PASSWORD}

RESTIC_BACKUP_INTERVAL="300" # Every X seconds
RESTIC_LOCK_RETRY="2m"

AWS_ACCESS_KEY_ID=${PAPRA_RESTIC_S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${PAPRA_RESTIC_S3_SECRET_KEY}
AWS_DEFAULT_REGION="us-east-1"

#-[ Retention
RESTIC_RETENTION_INTERVAL="86400" # Every X seconds
RESTIC_RETENTION_KEEP_HOURLY="24"
RESTIC_RETENTION_KEEP_DAILY="7"
RESTIC_RETENTION_KEEP_WEEKLY="4"
RESTIC_RETENTION_KEEP_MONTHLY="6"


# --------------------------------------
# -------------  PAPRA  ----------------
# --------------------------------------

#-[ Networking
APP_BASE_URL="https://files.jjcasa.net"
TRUSTED_ORIGINS="https://files.jjcasa.net"

#-[ Storage
DOCUMENT_STORAGE_DRIVER="s3"
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=${PAPRA_S3_ACCESS_KEY}
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=${PAPRA_S3_SECRET_KEY}
DOCUMENT_STORAGE_S3_BUCKET_NAME="papra"
DOCUMENT_STORAGE_S3_REGION="us-east-1"
DOCUMENT_STORAGE_S3_ENDPOINT="https://s3.jjcasa.net"
DOCUMENT_STORAGE_S3_FORCE_PATH_STYLE="false"

#-[ AI Features
AI_IS_ENABLED="true"
OPENROUTER_API_KEY=${PAPRA_OPENROUTER_API_KEY}
AI_DEFAULT_MODEL="openrouter://google/gemini-3-flash-preview"
AUTO_TAGGING_ENABLED="true"
AUTO_TAGGING_MODEL="openrouter://deepseek/deepseek-v4-flash"

#-[ Secrets
AUTH_SECRET=${PAPRA_AUTH_SECRET}

#-[ Registration & Authentication
AUTH_IS_REGISTRATION_ENABLED="true"
AUTH_PROVIDERS_EMAIL_IS_ENABLED="false"
PAPRA_OIDC_CLIENT_ID=${PAPRA_OIDC_CLIENT_ID}
PAPRA_OIDC_CLIENT_SECRET=${PAPRA_OIDC_CLIENT_SECRET}
PAPRA_OIDC_ISSUER=${PAPRA_OIDC_ISSUER}
