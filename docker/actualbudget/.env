# Secrets Manager Variables:
# MEMOS_POSTGRES_USER
# MEMOS_POSTGRES_PASSWORD "$(openssl rand -hex 32)"

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17-alpine"
MEMOS_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="memos"
POSTGRES_USER=${MEMOS_POSTGRES_USER}
POSTGRES_PASSWORD=${MEMOS_POSTGRES_PASSWORD}


# --------------------------------------
# -------------  MEMOS  ----------------
# --------------------------------------

#-[ Networking
MEMOS_INSTANCE_URL="https://memos.jjcasa.net"
MEMOS_ADDR="0.0.0.0"
MEMOS_PORT="5230"

#-[ Database Connection
MEMOS_DRIVER="postgres"

#-[ General
MEMOS_MODE="prod"
MEMOS_DATA="/var/opt/memos"
MEMOS_LOG_LEVEL="info"
