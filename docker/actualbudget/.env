# Secrets Manager Variables:
# ACTUAL_OIDC_ISSUER
# ACTUAL_OIDC_CLIENT_ID
# ACTUAL_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
ACTUAL_SERVER_IMAGE_TAG="latest"


# --------------------------------------
# ---------  ACTUAL BUDGET  ------------
# --------------------------------------

#-[ Authentication
ACTUAL_ALLOWED_LOGIN_METHODS=["openid"]
ACTUAL_LOGIN_METHOD="openid"
ACTUAL_OPENID_DISCOVERY_URL=${ACTUAL_OIDC_ISSUER}
ACTUAL_OPENID_CLIENT_ID=${ACTUAL_OIDC_CLIENT_ID}
ACTUAL_OPENID_CLIENT_SECRET=${ACTUAL_OIDC_CLIENT_SECRET}
ACTUAL_OPENID_SERVER_HOSTNAME="https://actual.jjcasa.net"
