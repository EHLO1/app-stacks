# Secrets Manager Variables:
# SEMAPHORE_POSTGRES_USER
# SEMAPHORE_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# SEMAPHORE_ADMIN
# SEMAPHORE_ADMIN_PASSWORD "$(openssl rand -hex 32)"
# SEMAPHORE_ADMIN_NAME
# SEMAPHORE_ADMIN_EMAIL
# SEMAPHORE_EMAIL_SENDER
# SEMAPHORE_EMAIL_USERNAME
# SEMAPHORE_EMAIL_PASSWORD
# SEMAPHORE_OIDC_ISSUER
# SEMAPHORE_OIDC_CLIENT_ID
# SEMAPHORE_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17-alpine"
SEMAPHORE_IMAGE_TAG="latest"

#-[ Timezone
TZ="America/Chicago"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="semaphore"
POSTGRES_USER=${SEMAPHORE_POSTGRES_USER}
POSTGRES_PASSWORD=${SEMAPHORE_POSTGRES_PASSWORD}

#-[ Semaphore
SEMAPHORE_DB_DIALECT="postgres"
SEMAPHORE_DB_HOST="semaphore-postgres"
SEMAPHORE_DB_NAME=${POSTGRES_DB}
SEMAPHORE_DB_USER=${POSTGRES_USER}
SEMAPHORE_DB_PASS=${POSTGRES_PASSWORD}


# --------------------------------------
# -----------  SEMAPHORE  --------------
# --------------------------------------

#-[ General
SEMAPHORE_WEB_ROOT="https://semaphore.jjcasa.net"
# Internal Port
SEMAPHORE_PORT="3000"
# Timezone
SEMAPHORE_SCHEDULE_TIMEZONE=${TZ}

#-[ Authentication
SEMAPHORE_ADMIN=${SEMAPHORE_ADMIN}
SEMAPHORE_ADMIN_PASSWORD=${SEMAPHORE_ADMIN_PASSWORD}
SEMAPHORE_ADMIN_NAME=${SEMAPHORE_ADMIN_NAME}
SEMAPHORE_ADMIN_EMAIL=${SEMAPHORE_ADMIN_EMAIL}

#-[ Email Notifications
SEMAPHORE_EMAIL_SENDER=${SEMAPHORE_EMAIL_SENDER}
SEMAPHORE_EMAIL_HOST="smtp.gmail.com"
SEMAPHORE_EMAIL_PORT="587"
SEMAPHORE_EMAIL_USERNAME=${SEMAPHORE_EMAIL_USERNAME}
SEMAPHORE_EMAIL_PASSWORD=${SEMAPHORE_EMAIL_PASSWORD}
SEMAPHORE_EMAIL_SECURE="true"
SEMAPHORE_EMAIL_TLS="true"

#-[ OIDC
SEMAPHORE_OIDC_ISSUER=${SEMAPHORE_OIDC_ISSUER}
SEMAPHORE_OIDC_CLIENT_ID=${SEMAPHORE_OIDC_CLIENT_ID}
SEMAPHORE_OIDC_CLIENT_SECRET=${SEMAPHORE_OIDC_CLIENT_SECRET}
