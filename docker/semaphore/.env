# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17"
SEMAPHORE_IMAGE_TAG="v2.16.51"

#-[ Timezone
TZ="America/Chicago"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Postgres
POSTGRES_USER=${S_SEMAPHORE_POSTGRES_USER}
POSTGRES_PASSWORD=${S_SEMAPHORE_POSTGRES_PASSWORD}
POSTGRES_DB="semaphore"

#-[ Semaphore
SEMAPHORE_DB_DIALECT="postgres"
SEMAPHORE_DB_HOST="postgres"
SEMAPHORE_DB_NAME=${POSTGRES_DB}
SEMAPHORE_DB_USER=${S_SEMAPHORE_POSTGRES_USER}
SEMAPHORE_DB_PASS=${S_SEMAPHORE_POSTGRES_PASSWORD}


# ––––––––––––––––––––––––––––––––––––––
# ––––––––-–  SEMAPHORE UI  ––––––––-–-–
# ––––––––––––––––––––––––––––––––––––––

#-[ General
# Primary URL
SUBDOMAIN="semaphore"
DOMAIN="jjcasa.net"
SEMAPHORE_WEB_ROOT="https://${SUBDOMAIN}.${DOMAIN}"
# Internal Port
SEMAPHORE_PORT="3000"
# Timezone
SEMAPHORE_SCHEDULE_TIMEZONE=${TZ}

#-[ Authentication
SEMAPHORE_ADMIN=${S_SEMAPHORE_ADMIN}
SEMAPHORE_ADMIN_PASSWORD=${S_SEMAPHORE_ADMIN_PASSWORD}
SEMAPHORE_ADMIN_NAME=${S_SEMAPHORE_ADMIN_NAME}
SEMAPHORE_ADMIN_EMAIL=${S_SEMAPHORE_ADMIN_EMAIL}

#-[ Email Notifications
SEMAPHORE_EMAIL_SENDER=${S_SEMAPHORE_EMAIL_SENDER}
SEMAPHORE_EMAIL_HOST="smtp.gmail.com"
SEMAPHORE_EMAIL_PORT="587"
SEMAPHORE_EMAIL_USERNAME=${S_SEMAPHORE_EMAIL_USERNAME}
SEMAPHORE_EMAIL_PASSWORD=${S_SEMAPHORE_EMAIL_PASSWORD}
SEMAPHORE_EMAIL_SECURE="True"
SEMAPHORE_EMAIL_TLS="True"

#-[ OIDC
SEMAPHORE_OIDC_ISSUER=${S_SEMAPHORE_OIDC_ISSUER}
SEMAPHORE_OIDC_CLIENT_ID=${S_SEMAPHORE_OIDC_CLIENT_ID}
SEMAPHORE_OIDC_CLIENT_SECRET=${S_SEMAPHORE_OIDC_CLIENT_SECRET}
