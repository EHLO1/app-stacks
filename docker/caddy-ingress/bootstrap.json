{
  "admin": {
    "listen": "127.0.0.1:2019",
    "identity": {
      "identifiers": [
        "komodo-app1.svc.jjcasa.net"
      ],
      "issuers": [
        {
          "module": "internal"
        }
      ]
    },
    "remote": {
      "listen": ":2021",
      "access_control": [
        {
          "public_keys": [
            ""
          ],
          "permissions": [
            {
              "paths": [
                "/config/apps/http/servers/ingress/routes"
              ],
              "methods": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          ]
        }
      ]
    }
  },
  "apps": {
    "http": {
      "servers": {
        "ingress": {
          "listen": [
            ":443"
          ],
          "routes": [],
          "tls_connection_policies": [
            {}
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": [
          "*.jjcasa.net",
          "*.internal.jjcasa.net",
          "*.admin.jjcasa.net"
        ]
      },
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme",
                "email": "{env.SSL_EMAIL}",
                "challenges": {
                  "dns": {
                    "provider": {
                      "name": "cloudflare",
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}"
                    },
                    "resolvers": [
                      "1.1.1.1:53",
                      "1.0.0.1:53"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
