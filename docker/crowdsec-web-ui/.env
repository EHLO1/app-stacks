# Secrets Manager Variables:
# CSWUI_0_LAPI_USERNAME
# CSWUI_0_LAPI_PASSWORD
# CSWUI_OIDC_ISSUER
# CSWUI_OIDC_CLIENT_ID
# CSWUI_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
CROWDSEC_WEB_UI_IMAGE_TAG="latest"


# --------------------------------------
# ---------  CROWDSEC WEB UI  ----------
# --------------------------------------
# CSWUI = CrowdSec Web UI

#-[ CrowdSec Instances
CONFIG_INSTANCES_0_LAPI_AUTH_USERNAME=${CSWUI_0_LAPI_USERNAME}
CONFIG_INSTANCES_0_LAPI_AUTH_PASSWORD=${CSWUI_0_LAPI_PASSWORD}

#-[ Authentication
# Callback Format: https://<crowdsec-web-ui-host>/api/auth/oidc/callback
CONFIG_AUTH_OIDC_ISSUER_URL=${CSWUI_OIDC_ISSUER}
CONFIG_AUTH_OIDC_CLIENT_ID=${CSWUI_OIDC_CLIENT_ID}
CONFIG_AUTH_OIDC_CLIENT_SECRET=${CSWUI_OIDC_CLIENT_SECRET}
