# Secrets Manager Variables:
# VAULTLS_API_SECRET "$(openssl rand -base64 32)"
# VAULTLS_DB_SECRET "$(openssl rand -hex 32)"
# VAULTLS_OIDC_ISSUER
# VAULTLS_OIDC_CLIENT_ID
# VAULTLS_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
VAULTLS_IMAGE_TAG="latest"


# --------------------------------------
# -------------  RESTIC  ---------------
# --------------------------------------

#-[ General
VAULTLS_URL="https://vaultls.jjcasa.net"

#-[ Secrets
VAULTLS_API_SECRET=${VAULTLS_API_SECRET}
VAULTLS_DB_SECRET=${VAULTLS_DB_SECRET}

#-[ Authentication
VAULTLS_OIDC_AUTH_URL=${VAULTLS_OIDC_ISSUER}
VAULTLS_OIDC_CALLBACK_URL="${VAULTLS_URL}/api/auth/oidc/callback"
VAULTLS_OIDC_ID=${VAULTLS_OIDC_CLIENT_ID}
VAULTLS_OIDC_SECRET=${VAULTLS_OIDC_CLIENT_SECRET}
VAULTLS_OIDC_ADDITIONAL_AUDIENCES="groups"

