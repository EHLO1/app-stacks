# Secrets Manager Variables:
# PORTABASE_POSTGRES_USER
# PORTABASE_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# PORTABASE_PROJECT_SECRET "$(openssl rand -hex 32)"
# PORTABASE_OIDC_ISSUER
# PORTABASE_OIDC_CLIENT_ID
# PORTABASE_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
PORTABASE_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="portabase"
POSTGRES_USER=${PORTABASE_POSTGRES_USER}
POSTGRES_PASSWORD=${PORTABASE_POSTGRES_PASSWORD}


# --------------------------------------
# -----------  PORTABASE  --------------
# --------------------------------------

#-[ Networking
PROJECT_URL="https://portabase.jjcasa.net"
TRUSTED_DOMAINS="${PORTABASE_OIDC_ISSUER}/.well-known/openid-configuration,${PROJECT_URL}"
TUSD_BEHIND_PROXY="true"
API_ENABLED="true"
OPENAPI_ENABLED="true"

#-[ Database Connection
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@portabase-postgres:5432/${POSTGRES_DB}"

#-[ Secrets
PROJECT_SECRET=${PORTABASE_PROJECT_SECRET}

#-[ General
TZ="America/Chicago"

#-[ Authentication
# Callback: https://portabase.jjcasa.net/api/auth/sso/callback/pocketid
AUTH_EMAIL_PASSWORD_ENABLED="false"
AUTH_SIGNUP_ENABLED="true"
AUTH_OIDC_POCKET_ID="pocketid"
AUTH_OIDC_POCKET_TITLE="JJCasa ID"
AUTH_OIDC_POCKET_DESC="Login with JJCasa ID"
AUTH_OIDC_POCKET_ICON="https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/pocket-id.svg"
AUTH_OIDC_POCKET_CLIENT=${PORTABASE_OIDC_CLIENT_ID}
AUTH_OIDC_POCKET_SECRET=${PORTABASE_OIDC_CLIENT_SECRET}
AUTH_OIDC_POCKET_ISSUER_URL=${PORTABASE_OIDC_ISSUER}
AUTH_OIDC_POCKET_SCOPES="openid profile email groups"
AUTH_OIDC_POCKET_PKCE="true"
AUTH_OIDC_POCKET_ROLE_MAP="portabase_admins:admin"
AUTH_OIDC_POCKET_ALLOW_UNLINKING="false"
