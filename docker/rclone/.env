# Secrets Manager Variables:
# APP_NAME_RCLONE_S3_ACCESS_KEY
# APP_NAME_RCLONE_S3_SECRET_KEY

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
RCLONE_IMAGE_TAG="latest"


# --------------------------------------
# -------------  RCLONE  ---------------
# --------------------------------------

#-[ General
RCLONE_S3_BUCKET="app-name-volume-backup"
RCLONE_SYNC_INTERVAL="60"
RCLONE_CONFIG_S3_TYPE="s3"
RCLONE_CONFIG_S3_PROVIDER="Other"
RCLONE_CONFIG_S3_ACCESS_KEY_ID=${APP_NAME_RCLONE_S3_ACCESS_KEY}
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${APP_NAME_RCLONE_S3_SECRET_KEY}
RCLONE_CONFIG_S3_ENDPOINT="s3.jjcasa.net"
RCLONE_CONFIG_S3_REGION="us-east-1"
