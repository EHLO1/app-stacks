# Secrets Manager Variables:
# HOMEBOX_POSTGRES_USER
# HOMEBOX_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# HOMEBOX_AUTH_API_KEY_PEPPER "$(openssl rand -base64 48)"
# HOMEBOX_SMTP_HOST
# HOMEBOX_SMTP_PORT
# HOMEBOX_SMTP_USERNAME
# HOMEBOX_SMTP_PASSWORD
# HOMEBOX_SMTP_FROM
# HOMEBOX_OIDC_ISSUER
# HOMEBOX_OIDC_CLIENT_ID
# HOMEBOX_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
HOMEBOX_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="homebox"
POSTGRES_USER=${HOMEBOX_POSTGRES_USER}
POSTGRES_PASSWORD=${HOMEBOX_POSTGRES_PASSWORD}


# --------------------------------------
# ------------  HOMEBOX  ---------------
# --------------------------------------
# Reference: https://homebox.software/en/quick-start/configure/

#-[ Network
HBOX_OPTIONS_HOSTNAME="homebox.jjcasa.net"
HBOX_OPTIONS_TRUST_PROXY="true"

#-[ General
HBOX_MODE="production"
HBOX_OPTIONS_ALLOW_ANALYTICS="true"

#-[ Storage
HBOX_WEB_MAX_UPLOAD_SIZE="25"

#-[ Secrets
HBOX_AUTH_API_KEY_PEPPER=${HOMEBOX_AUTH_API_KEY_PEPPER}

#-[ Logging
HBOX_LOG_LEVEL="info"
HBOX_LOG_FORMAT="json"

#-[ Database Connection
HBOX_DATABASE_DRIVER="postgres"
HBOX_DATABASE_HOST="homebox-postgres"
HBOX_DATABASE_PORT="5432"
HBOX_DATABASE_USERNAME=${POSTGRES_USER}
HBOX_DATABASE_PASSWORD=${POSTGRES_PASSWORD}
HBOX_DATABASE_DATABASE=${POSTGRES_DB}
HBOX_DATABASE_SSL_MODE="disable"

#-[ SMTP
HBOX_MAILER_HOST=${HOMEBOX_SMTP_HOST}
HBOX_MAILER_PORT=${HOMEBOX_SMTP_PORT}
HBOX_MAILER_USERNAME=${HOMEBOX_SMTP_USERNAME}
HBOX_MAILER_PASSWORD=${HOMEBOX_SMTP_PASSWORD}
HBOX_MAILER_FROM=${HOMEBOX_SMTP_FROM}

#-[ Authentication
HBOX_OPTIONS_ALLOW_REGISTRATION="true"
HBOX_OPTIONS_ALLOW_LOCAL_LOGIN="false"
HBOX_OIDC_ENABLED="true"
HBOX_OIDC_ISSUER_URL=${HOMEBOX_OIDC_ISSUER}
HBOX_OIDC_CLIENT_ID=${HOMEBOX_OIDC_CLIENT_ID}
HBOX_OIDC_CLIENT_SECRET=${HOMEBOX_OIDC_CLIENT_SECRET}
HBOX_OIDC_SCOPE="openid profile email groups"
HBOX_OIDC_ALLOWED_GROUPS="homebox_admins,homebox_viewers"
HBOX_OIDC_AUTO_REDIRECT="false"
HBOX_OIDC_VERIFY_EMAIL="true"
HBOX_OIDC_BUTTON_TEXT="Sign in with JJCasa ID"
