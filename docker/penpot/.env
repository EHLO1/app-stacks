# Secrets Manager Variables:
# PENPOT_POSTGRES_USER
# PENPOT_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# PENPOT_SECRET_KEY 512-bit Base64
# PENPOT_OIDC_ISSUER
# PENPOT_OIDC_CLIENT_ID
# PENPOT_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
PENPOT_IMAGE_TAG="latest"
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="penpot"
POSTGRES_USER=${PENPOT_POSTGRES_USER}
POSTGRES_PASSWORD=${PENPOT_POSTGRES_PASSWORD}

#-[ Valkey
VALKEY_EXTRA_FLAGS="--maxmemory 128mb --maxmemory-policy volatile-lfu"

# --------------------------------------
# -------------  PENPOT  ---------------
# --------------------------------------
# Reference: https://help.penpot.app/technical-guide/configuration/

#-[ Networking
PENPOT_PUBLIC_URI="https://pp.jjcasa.net"
PENPOT_INTERNAL_URI="http://penpot-frontend:8080"

#-[ General
PENPOT_FLAGS="disable-email-verification enable-prepl-server enable-login-with-oidc enable-oidc-registration disable-login-with-password"
PENPOT_HTTP_SERVER_MAX_BODY_SIZE="367001600"

#-[ Secrets
PENPOT_SECRET_KEY=${PENPOT_SECRET_KEY}

#-[ Database Connection
PENPOT_DATABASE_URI="postgresql://penpot-postgres/${POSTGRES_DB}"
PENPOT_DATABASE_USERNAME=${POSTGRES_USER}
PENPOT_DATABASE_PASSWORD=${POSTGRES_PASSWORD}
PENPOT_REDIS_URI="redis://penpot-valkey/0"

#-[ Storage
PENPOT_OBJECTS_STORAGE_BACKEND="fs"
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY="/opt/data/assets"

#-[ Optional Telemetry
PENPOT_TELEMETRY_ENABLED="true"
PENPOT_TELEMETRY_REFERER="compose"

#-[ Authentication
PENPOT_OIDC_NAME="JJCasa ID"
PENPOT_OIDC_BASE_URI=${PENPOT_OIDC_ISSUER}
PENPOT_OIDC_CLIENT_ID=${PENPOT_OIDC_CLIENT_ID}
PENPOT_OIDC_CLIENT_SECRET=${PENPOT_OIDC_CLIENT_SECRET}
PENPOT_OIDC_SCOPES="openid email profile groups"
PENPOT_OIDC_ROLES_ATTR="groups"
PENPOT_OIDC_ROLES="penpot_admins"
