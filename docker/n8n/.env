# Secrets Manager Variables:
# N8N_POSTGRES_USER
# N8N_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# N8N_ENCRYPTION_KEY "$(openssl rand -hex 32)"
# N8N_RUNNERS_AUTH_TOKEN "$(openssl rand -hex 32)"
# N8N_USER_MANAGEMENT_JWT_SECRET "$(openssl rand -hex 32)"

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
N8N_IMAGE_TAG="latest"
N8N_RUNNERS_IMAGE_TAG="latest"
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"

#-[ Timezone
GENERIC_TIMEZONE="America/Chicago"

#-[ Logging
LOG_LEVEL="info"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="n8n"
POSTGRES_USER=${N8N_POSTGRES_USER}
POSTGRES_PASSWORD=${N8N_POSTGRES_PASSWORD}


# --------------------------------------
# --------  N8N TASK RUNNERS  ----------
# --------------------------------------

#-[ General
N8N_RUNNERS_TASK_BROKER_URI="http://n8n-worker:5679"
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT="15"
N8N_RUNNERS_MAX_CONCURRENCY="10"

#-[ Logging
N8N_RUNNERS_LAUNCHER_LOG_LEVEL=${LOG_LEVEL}


# --------------------------------------
# -----------  N8N WORKERS  ------------
# --------------------------------------

#-[ Secrets
N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}

#-[ Executions
EXECUTIONS_MODE="queue"
# Set to "true" to run manual executions on the worker node.
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS="true"

#-[ Redis (Valkey)
QUEUE_BULL_REDIS_HOST="n8n-valkey"
QUEUE_BULL_REDIS_PORT="6379"

#-[ Health Check
QUEUE_HEALTH_CHECK_ACTIVE="true"
N8N_WORKER_SERVER_ADDRESS="127.0.0.1"


# --------------------------------------
# ---------------  N8N  ----------------
# --------------------------------------
# Reference: https://docs.n8n.io/hosting/configuration/environment-variables/

#-[ Networking
# Primary URL
N8N_PROTOCOL="https"
N8N_HOST="workflows.jjcasa.net"
N8N_PORT="5678"
N8N_LISTEN_ADDRESS="0.0.0.0"
# Required when n8n is running behind a reverse proxy
N8N_PROXY_HOPS="1"
WEBHOOK_URL="${N8N_PROTOCOL}://${N8N_HOST}"
# N8N Platform API
N8N_PUBLIC_API_SWAGGERUI_DISABLED="false"

#-[ Database Settings
DB_TYPE="postgresdb"
DB_POSTGRESDB_HOST="n8n-postgres"
DB_POSTGRESDB_PORT="5432"
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

#-[ Runners
N8N_RUNNERS_MODE="external"
N8N_RUNNERS_AUTH_TOKEN=${N8N_RUNNERS_AUTH_TOKEN}
N8N_RUNNERS_BROKER_LISTEN_ADDRESS="0.0.0.0"
N8N_RUNNERS_INSECURE_MODE="false"
N8N_PYTHON_ENABLED="true"
N8N_NATIVE_PYTHON_RUNNER="true"

#-[ Metrics & Diagnostics
N8N_DIAGNOSTICS_ENABLED="true"
N8N_METRICS="true"

#-[ Secrets
N8N_USER_MANAGEMENT_JWT_SECRET=${N8N_USER_MANAGEMENT_JWT_SECRET}

#-[ Data Limits
N8N_DATA_TABLES_MAX_SIZE_BYTES="1048576000"  # 1 GB
N8N_BLOCK_ENV_ACCESS_IN_NODE="false"

#-[ Miscellaneous
N8N_DEFAULT_BINARY_DATA_MODE="database"
N8N_RESTRICT_FILE_ACCESS_TO="/home/node/.n8n-files"
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="false"
N8N_VERSION_NOTIFICATIONS_ENABLED="true"
# Community Packages
N8N_COMMUNITY_PACKAGES_ENABLED="true"
# Disable n8n bloat
N8N_PERSONALIZATION_ENABLED="false"
N8N_HIRING_BANNER_ENABLED="false"
