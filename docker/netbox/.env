# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17"
VALKEY_IMAGE_TAG="8.1-alpine"
NETBOX_IMAGE_TAG="v4.5"


# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

#-[ Postgres
POSTGRES_USER=${S_NETBOX_POSTGRES_USER}
POSTGRES_PASSWORD=${S_NETBOX_POSTGRES_PASSWORD}
POSTGRES_DB="netbox"

#-[ Netbox
DB_HOST="postgres"
DB_NAME=${POSTGRES_DB}
DB_USER=${S_NETBOX_POSTGRES_USER}
DB_PASSWORD=${S_NETBOX_POSTGRES_PASSWORD}


# ––––––––––––––––––––––––––––––––––––––
# –––––––––-–––  NETBOX  –––––––––––-–-–
# ––––––––––––––––––––––––––––––––––––––

#-[ General
# Webhooks
WEBHOOKS_ENABLED=true

#-[ Superuser Creation
# I didn't want to, but bugs made me do it
SKIP_SUPERUSER="false"
SUPERUSER_NAME=${S_NETBOX_SUPERUSER_NAME}
SUPERUSER_PASSWORD=${S_NETBOX_SUPERUSER_PASSWORD}
SUPERUSER_EMAIL=${S_NETBOX_SUPERUSER_EMAIL}
SUPERUSER_API_TOKEN=${S_NETBOX_SUPERUSER_API_TOKEN}

#-[ Secrets
SECRET_KEY=${S_NETBOX_SECRET_KEY}
API_TOKEN_PEPPER_1=${S_NETBOX_API_TOKEN_PEPPER_1}

#-[ Redis (jk, just ValKey again) Configuration
REDIS_CACHE_DATABASE="1"
REDIS_CACHE_HOST="redis-cache"
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY="false"
REDIS_CACHE_PASSWORD=${S_NETBOX_REDIS_PASSWORD}
REDIS_CACHE_SSL="false"
REDIS_DATABASE="0"
REDIS_HOST="redis"
REDIS_INSECURE_SKIP_TLS_VERIFY="false"
REDIS_PASSWORD=${S_NETBOX_REDIS_PASSWORD}
REDIS_SSL="false"

#-[ Email Notifications
EMAIL_FROM=${S_NETBOX_EMAIL_FROM}
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME=${S_NETBOX_EMAIL_USERNAME}
EMAIL_PASSWORD=${S_NETBOX_EMAIL_PASSWORD}
EMAIL_TLS="True"
EMAIL_TIMEOUT="5"

#-[ Miscellaneous
GRAPHQL_ENABLED="true"
METRICS_ENABLED="false"
RELEASE_CHECK_URL="https://api.github.com/repos/netbox-community/netbox/releases"
MEDIA_ROOT="/opt/netbox/netbox/media"
CORS_ORIGIN_ALLOW_ALL="true"
