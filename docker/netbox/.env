# Secrets Manager Variables:
# NETBOX_POSTGRES_USER
# NETBOX_POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# NETBOX_SUPERUSER_NAME
# NETBOX_SUPERUSER_PASSWORD "$(openssl rand -hex 32)"
# NETBOX_SUPERUSER_EMAIL
# NETBOX_SUPERUSER_API_TOKEN "$(openssl rand -hex 32)"
# NETBOX_SECRET_KEY "$(openssl rand -hex 32)"
# NETBOX_API_TOKEN_PEPPER_1 "$(openssl rand -hex 32)"
# NETBOX_REDIS_PASSWORD "$(openssl rand -hex 32)"
# NETBOX_EMAIL_FROM
# NETBOX_EMAIL_USERNAME
# NETBOX_EMAIL_PASSWORD

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
# Best practice is to pin a specific version, instead of using 'latest'
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"
NETBOX_IMAGE_TAG="v5.0"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_USER=${NETBOX_POSTGRES_USER}
POSTGRES_PASSWORD=${NETBOX_POSTGRES_PASSWORD}
POSTGRES_DB="netbox"

#-[ Netbox
DB_HOST="netbox-postgres"
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}


# --------------------------------------
# -------------  NETBOX  ---------------
# --------------------------------------

#-[ General
# Webhooks
WEBHOOKS_ENABLED="true"

#-[ Superuser Creation
# I didn't want to, but bugs made me do it
SKIP_SUPERUSER="false"
SUPERUSER_NAME=${NETBOX_SUPERUSER_NAME}
SUPERUSER_PASSWORD=${NETBOX_SUPERUSER_PASSWORD}
SUPERUSER_EMAIL=${NETBOX_SUPERUSER_EMAIL}
SUPERUSER_API_TOKEN=${NETBOX_SUPERUSER_API_TOKEN}

#-[ Secrets
SECRET_KEY=${NETBOX_SECRET_KEY}
API_TOKEN_PEPPER_1=${NETBOX_API_TOKEN_PEPPER_1}

#-[ Redis (jk, just ValKey again) Configuration
REDIS_CACHE_DATABASE="1"
REDIS_CACHE_HOST="netbox-valkey-cache"
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY="false"
REDIS_CACHE_PASSWORD=${NETBOX_REDIS_PASSWORD}
REDIS_CACHE_SSL="false"
REDIS_DATABASE="0"
REDIS_HOST="netbox-valkey"
REDIS_INSECURE_SKIP_TLS_VERIFY="false"
REDIS_PASSWORD=${NETBOX_REDIS_PASSWORD}
REDIS_SSL="false"

#-[ Email Notifications
EMAIL_FROM=${NETBOX_EMAIL_FROM}
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME=${NETBOX_EMAIL_USERNAME}
EMAIL_PASSWORD=${NETBOX_EMAIL_PASSWORD}
EMAIL_TLS="true"
EMAIL_TIMEOUT="5"

#-[ Miscellaneous
GRAPHQL_ENABLED="true"
METRICS_ENABLED="false"
RELEASE_CHECK_URL="https://api.github.com/repos/netbox-community/netbox/releases"
MEDIA_ROOT="/opt/netbox/netbox/media"
CORS_ORIGIN_ALLOW_ALL="true"
