# Secrets Manager Variables:
# CHATTO_NATS_TOKEN "$(openssl rand -hex 32)"

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
NATS_IMAGE_TAG="latest"
CHATTO_IMAGE_TAG="latest"


# --------------------------------------
# --------------  NATS  ----------------
# --------------------------------------

#-[ Secrets
NATS_TOKEN=${CHATTO_NATS_TOKEN}


# --------------------------------------
# -------------  CHATTO  ---------------
# --------------------------------------
# Reference: https://docs.chatto.run/reference/environment-variables/

#-[ RunAs
PUID="1000"
PGID="1000"

# Remaining config is generated from Doppler Secrets Manager at runtime and passed in as chatto.toml.
