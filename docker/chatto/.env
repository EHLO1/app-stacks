# Secrets Manager Variables:
#   CHATTO_NATS_TOKEN "$(openssl rand -hex 32)"
#   CHATTO_NATS_CLIENT_TOKEN "$(openssl rand -hex 32)"
#   CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET "$(openssl rand -hex 32)"
#   CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET "$(openssl rand -hex 32)"
#   CHATTO_CORE_SECRET_KEY "$(openssl rand -hex 32)"
#   CHATTO_CORE_ASSETS_SIGNING_SECRET "$(openssl rand -hex 32)"
#   CHATTO_LIVEKIT_API_SECRET "$(openssl rand -hex 32)"

# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––-  COMMON  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

#-[ Image Tags (App Versions)
N8N_IMAGE_TAG="latest"
N8N_RUNNERS_IMAGE_TAG="latest"
POSTGRES_IMAGE_TAG="17-alpine"
VALKEY_IMAGE_TAG="9-alpine"




PUBLIC_URL="chat.dysfunctional.games"
CHATTO_OWNERS_EMAILS=${CHATTO_OWNERS_EMAILS}

PUID=1000
PGID=1000

NATS_TOKEN=${CHATTO_NATS_TOKEN}

CHATTO_NATS_EMBEDDED_ENABLED="false"
CHATTO_NATS_CLIENT_URL="nats://nats:4222"
CHATTO_NATS_CLIENT_AUTH_METHOD="token"
CHATTO_NATS_CLIENT_TOKEN=${CHATTO_NATS_CLIENT_TOKEN}

CHATTO_WEBSERVER_URL=https://chat.dysfunctional.games

CHATTO_WEBSERVER_PORT="4000"
CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET=${CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET}
CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET=${CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET}
CHATTO_CORE_SECRET_KEY=${CHATTO_CORE_SECRET_KEY}
CHATTO_CORE_ASSETS_SIGNING_SECRET=${CHATTO_CORE_ASSETS_SIGNING_SECRET}
CHATTO_LOG_LEVEL="info"
CHATTO_LOG_FORMAT="json"
CHATTO_OPERATOR_API_ENABLED="true"
CHATTO_OPERATOR_API_SOCKET_PATH="/tmp/chatto/operator.sock"

CHATTO_SMTP_ENABLED="false"

LIVEKIT_CONFIG_FILE="./livekit.yaml"
CHATTO_LIVEKIT_ENABLED="true"
CHATTO_LIVEKIT_URL="wss://livekit.dysfunctional.games"
CHATTO_LIVEKIT_API_KEY="chatto"
CHATTO_LIVEKIT_API_SECRET=${CHATTO_LIVEKIT_API_SECRET}
