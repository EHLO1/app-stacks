# Secrets Manager Variables:
# VMAUTH_USERNAME
# VMAUTH_PASSWORD
# GRAFANA_ADMIN_USER
# GRAFANA_ADMIN_PASSWORD

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
VICTORIAMETRICS_IMAGE_TAG="latest"
VMAUTH_IMAGE_TAG="latest"
GRAFANA_IMAGE_TAG="latest"


# --------------------------------------
# -------------  VMAUTH  ---------------
# --------------------------------------

#-[ Authentication
VMAUTH_USERNAME=${VMAUTH_USERNAME}
VMAUTH_PASSWORD=${VMAUTH_PASSWORD}


# --------------------------------------
# ------------  GRAFANA  ---------------
# --------------------------------------

#-[ General
GF_SERVER_ROOT_URL="https://grafana.admin.jjcasa.net/"

#-[ Authentication
GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
